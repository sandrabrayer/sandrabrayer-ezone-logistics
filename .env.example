# Copy to .env and fill with real values. .env is gitignored — never commit it.
# In production these are Railway env vars. The server REFUSES TO START if any required value below
# is missing or empty (fail-closed) — set them BEFORE the deploy.

# The Apps Script web app /exec URL for THIS app's deployment (not Dashboard/Managers).
APPS_SCRIPT_EXEC_URL=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec

# ONE shared login access code. Every roster user (active managers + maintenance leads: רועי, אולגה,
# סנדרה, רמי, צחי) logs in with { name, this-code }. Coordinators no longer log in here. Replaces the old
# per-user pin_hash + tier-B APP_PIN scheme. Verified server-side with a constant-time compare; trimmed on
# load so a stray trailing space/newline in the Railway value can't make every login fail.
SHARED_ACCESS_CODE=REPLACE_WITH_SHARED_ACCESS_CODE

# Session-token signing secret (HMAC-SHA256). Must be at least 32 chars. THIS EXACT VALUE must also
# be set as the SESSION_SECRET Script Property in the Apps Script project, so Code.gs can verify the
# same Bearer token independently. Never commit it.
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# Session-token lifetime in days (tokens expire after this many days → 401).
SESSION_DAYS=7

# Frontend server port for local dev / Railway.
PORT=3000
